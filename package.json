{
  "name": "GSA",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/sqlite": "^3.1.2",
    "@sap/cds": "^10",
    "@sap/xssec": "^4",
    "nodemailer": "^10.1.7"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-spacefarers": "cds watch --open spacefarers/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "mail": {
        "impl": "srv/mail-service.js",
        "queued": true,
        "from": "Galactic Spacefarer Adventure <noreply@galactic-spacefarer-adventure.com>"
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "viewer": {
              "roles": [
                "SpacefarerViewer"
              ],
              "attr": {
                "planet": "Earth"
              }
            },
            "admin": {
              "roles": [
                "SpacefarerAdmin"
              ],
              "attr": {
                "planet": "Earth"
              }
            },
            "martian": {
              "roles": [
                "SpacefarerViewer"
              ],
              "attr": {
                "planet": "Mars"
              }
            }
          }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "devDependencies": {
    "cds-plugin-ui5": "^0.17.0"
  },
  "sapux": [
    "app/spacefarers"
  ]
}
