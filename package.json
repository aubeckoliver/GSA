{
  "name": "GSA",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/sqlite": "^3.1.2",
    "@sap/cds": "^10",
    "@sap/xssec": "^4",
    "nodemailer": "^10.1.7"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "mail": {
        "impl": "srv/mail-service.js",
        "queued": true,
        "from": "Galactic Spacefarer Adventure <noreply@galactic-spacefarer-adventure.com>"
      },
      "[production]": {
        "auth": "xsuaa"
      }
    }
  }
}
